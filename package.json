{
  "name": "proofwall",
  "version": "1.0.0",
  "description": "Self-hosted testimonial collector and Wall of Love. Runs on Cloudflare Workers or any Node/Docker host.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-client.mjs",
    "build:node": "node scripts/build-client.mjs && node scripts/build-node.mjs",
    "start": "node dist/server.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.node.json",
    "seed:local": "wrangler d1 execute DB --local --file=./scripts/seed.sql"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.14",
    "htmlparser2": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
