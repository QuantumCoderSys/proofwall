# Copy to `.dev.vars` (or `.env`) for local development:  cp .env.example .dev.vars
# In production, store these in your host's secret manager (see AGENTS.md).

# Password for the founder dashboard. Use something long.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string used to sign session cookies. Generate one with: openssl rand -hex 32
# Rotating it (or the password) signs everyone out.
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Optional: where the "Powered by ProofWall" badge links.
# POWERED_BY_URL=

# Node/Docker hosts only (ignored on Cloudflare):
# PORT=8080
# DATA_DIR=./data
# PUBLIC_URL=https://testimonials.example.com
